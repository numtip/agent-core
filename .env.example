# Agent Core runtime
AGENT_CORE_ENV=development
AGENT_CORE_HOST=127.0.0.1
AGENT_CORE_PORT=8787

# Provider secret — set only in trusted runtime environment
OPENROUTER_API_KEY=

# OpenRouter Decisions endpoint.
# Override only for testing or controlled migration.
OPENROUTER_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
OPENROUTER_TIMEOUT_MS=8000

# Confidence policy
CONFIDENCE_EXECUTE=0.85
CONFIDENCE_REVIEW=0.60

# Optional local development settings
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/agent-core.db

# Jev model policy is owned by Agent Core and intentionally not exposed as env.
# Default: ~typesafe/jev-latest
# Never put production secrets in this file.
