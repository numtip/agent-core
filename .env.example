# Agent Core runtime
AGENT_CORE_ENV=development
AGENT_CORE_HOST=127.0.0.1
AGENT_CORE_PORT=8787

# Production should set this to true.
AGENT_CORE_AUTH_REQUIRED=false

# JSON maps. Keep real values outside Git.
# Local example (copy to .env; never commit real tokens):
# AGENT_CORE_PROJECT_KEYS={"agent-core":"local-dev-token"}
# AGENT_CORE_PROJECT_SCOPES={"agent-core":["decision","route","qa","context","metrics"]}
AGENT_CORE_PROJECT_KEYS={}
AGENT_CORE_PROJECT_SCOPES={}

# Client-side only (Cursor / CLI):
# AGENT_PLATFORM_URL=http://127.0.0.1:8787
# AGENT_PROJECT=agent-core
# AGENT_PROJECT_TOKEN=local-dev-token

# Rate limiting
AGENT_CORE_RATE_LIMIT_MAX=100
AGENT_CORE_RATE_LIMIT_WINDOW_MS=60000

# Audit log
AGENT_CORE_AUDIT_LOG=./logs/audit.jsonl

# Provider secret — trusted runtime only
OPENROUTER_API_KEY=
OPENROUTER_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
OPENROUTER_TIMEOUT_MS=8000

# Confidence policy
CONFIDENCE_EXECUTE=0.85
CONFIDENCE_REVIEW=0.60

# Jev model is owned by Agent Core: ~typesafe/jev-latest
# Never put production secrets in this file.

# Bounded local REA MCP handoff (Cursor client executes user-rea tools).
# Fail-closed by default; enable only on trusted local workstations.
REA_LOCAL_HANDOFF_ENABLED=false
# JSON array of absolute workspace roots, e.g. ["F:\\\\projectAi\\\\REA"]
REA_WORKSPACE_ROOTS=[]
REA_PACKAGE_VERSION=6.4.0
